'use client'

import { useState, useEffect, use } from 'react'
import { ArrowLeft, Heart, Brain, Zap, Frown, Users, BrainCircuit, Battery, Flame, Sparkles, CloudLightning, Rainbow, AlertCircle, Skull, CloudRain, Waves, BookOpen, CloudDrizzle, Shield, UserX } from 'lucide-react'
import { Button } from '@/components/ui/button'
import React from 'react'

// Hardcoded guide mappings
const FEELING_GUIDE_MAPPINGS = {
  'mental fog': {
    title: 'Mental Fog and Overload Guide',
    slug: 'mentalfog',
    emoji: '😶‍🌫️',
    description: 'Navigate mental fog and overwhelm with practical ADHD-friendly strategies'
  },
  'overwhelmed': {
    title: 'Mental Fog and Overload Guide',
    slug: 'mentalfog',
    emoji: '😶‍🌫️',
    description: 'Navigate mental fog and overwhelm with practical ADHD-friendly strategies'
  },
  'forgetful': {
    title: 'Mental Fog and Overload Guide',
    slug: 'mentalfog',
    emoji: '😶‍🌫️',
    description: 'Navigate mental fog and overwhelm with practical ADHD-friendly strategies'
  },
  'scattered': {
    title: 'Mental Fog and Overload Guide',
    slug: 'mentalfog',
    emoji: '😶‍🌫️',
    description: 'Navigate mental fog and overwhelm with practical ADHD-friendly strategies'
  },
  'overstimulated': {
    title: 'Mental Fog and Overload Guide',
    slug: 'mentalfog',
    emoji: '😶‍🌫️',
    description: 'Navigate mental fog and overwhelm with practical ADHD-friendly strategies'
  }
}

interface FeelingPageProps {
  params: Promise<{
    feeling: string
  }>
}

export default function FeelingPage({ params }: FeelingPageProps) {
  const resolvedParams = use(params)
  const [feelingName, setFeelingName] = useState<string>('')
  const [feelingIcon, setFeelingIcon] = useState<React.ElementType>(Heart)
  const [availableGuide, setAvailableGuide] = useState<any>(null)

  useEffect(() => {
    // Convert URL param back to display name
    const name = decodeURIComponent(resolvedParams.feeling)
      .split('-')
      .map(word => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ')
    setFeelingName(name)

    // Map feelings to Lucide icons (matching main feelings page)
    const iconMap: Record<string, React.ElementType> = {
      // Mental Fog & Overload
      'Mental Fog': CloudDrizzle,
      'Overwhelmed': Waves,
      'Forgetful': Brain,
      'Scattered': CloudLightning,
      'Overstimulated': Sparkles,
      
      // Dysregulation & Shutdown
      'Stuck': BrainCircuit,
      'Drained': Battery,
      'Burned Out': Flame,
      'Numb': Skull,
      'Ashamed': Frown,
      'Frustrated': Flame,
      
      // Heavy Feelings
      'Guilty': AlertCircle,
      'Defeated': CloudRain,
      'Hopeless': CloudRain,
      'Stressed': Zap,
      
      // Jittery & Wound Up
      'Anxious': AlertCircle,
      'Restless': Sparkles,
      'Wired': Zap,
      'Tense': Shield,
      
      // Social & Connection
      'Lonely': Users,
      'Misunderstood': Users,
      'Rejected': UserX
    }
    setFeelingIcon(iconMap[name] || Heart)

    // Check if there's a guide for this feeling
    const feelingKey = name.toLowerCase().trim()
    console.log('Checking for guide for feeling:', feelingKey)
    
    const matchedGuide = FEELING_GUIDE_MAPPINGS[feelingKey as keyof typeof FEELING_GUIDE_MAPPINGS]
    
    if (matchedGuide) {
      console.log('Found matching guide:', matchedGuide)
      setAvailableGuide(matchedGuide)
    } else {
      console.log('No guide found for feeling:', feelingKey)
      setAvailableGuide(null)
    }
  }, [resolvedParams.feeling])

  const goBack = () => {
    window.history.back()
  }

  // Example validation messages for different feelings
  const getValidationMessage = (feeling: string) => {
    const messages: Record<string, string> = {
      'Stuck': "You're not lazy. You're frozen. Your nervous system has hit pause to protect you.",
      'Overwhelmed': "Your brain is doing its best to process everything. It's okay to feel flooded right now.",
      'Burned Out': "You've been running on empty for too long. This exhaustion is real and valid.",
      'Ashamed': "Shame lies. You are not broken, behind, or too much. You're human with a different brain.",
      'Anxious': "Your nervous system is trying to keep you safe. These feelings will pass.",
      'Drained': "You've been giving more than you have. It's time to refill your cup.",
      'Lonely': "Feeling disconnected doesn't mean you're unlovable. Your people are out there.",
      'Scattered': "Your brain isn't chaotic - it's creative and sees connections others miss.",
      'Hopeless': "This darkness is temporary. Your worth isn't determined by your productivity."
    }
    return messages[feeling] || `What you're feeling is valid. You're not alone in this experience.`
  }

  // Micro strategies based on the feeling
  const getMicroStrategies = (feeling: string) => {
    const strategies: Record<string, Array<{title: string, description: string}>> = {
      'Stuck': [
        { title: "Sit near the mess", description: "Without doing anything. Just be present with it." },
        { title: "Run warm water over your hands", description: "Let the sensation ground you in the moment." },
        { title: "Press play on a 1-minute playlist", description: "Movement can unstick stuck energy." }
      ],
      'Overwhelmed': [
        { title: "Name 3 things you can see", description: "Bring your attention back to the present moment." },
        { title: "Put everything in your brain on paper", description: "External brain storage frees up mental space." },
        { title: "Pick the tiniest possible next step", description: "Movement creates momentum." }
      ],
      'Burned Out': [
        { title: "Permission to do nothing", description: "Rest is productive. Recovery is necessary." },
        { title: "Lower the bar completely", description: "What would 'good enough' look like today?" },
        { title: "Ask: what would I tell a friend?", description: "Give yourself the compassion you'd show others." }
      ]
    }
    
    return strategies[feeling] || [
      { title: "Take one deep breath", description: "Sometimes the first step is just acknowledging where you are." },
      { title: "Move your body gently", description: "A walk, stretch, or dance can shift your state." },
      { title: "Reach out to someone", description: "Connection can change everything." }
    ]
  }

  const microStrategies = getMicroStrategies(feelingName)

  return (
    <div className="min-h-screen bg-gradient-to-br from-[#fbc2eb] via-[#fbd786] to-[#fbc687] relative">
      <div className="max-w-4xl mx-auto px-4 py-8 pt-24">
        <div className="bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-2xl p-6 md:p-10 shadow-lg">
          {/* Header */}
          <div className="mb-8">
            <div className="flex items-center gap-4 mb-6">
              <Button
                variant="ghost"
                size="default"
                onClick={goBack}
                className="p-2 hover:bg-white/20 dark:hover:bg-gray-700 rounded-full"
              >
                <ArrowLeft className="h-5 w-5" />
              </Button>
              <div>
                <h1 className="text-3xl md:text-4xl font-serif font-bold text-foreground flex items-center gap-3">
                  {React.createElement(feelingIcon, {
                    className: "h-8 w-8 text-pink-500"
                  })}
                  {feelingName}
                </h1>
              </div>
            </div>

            {/* Validation Header */}
            <div className="bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-2xl p-6 mb-8">
              <p className="text-lg md:text-xl text-foreground leading-relaxed">
                {getValidationMessage(feelingName)}
              </p>
            </div>
          </div>

          {/* Micro Strategies */}
          <div className="mb-8">
            <h2 className="text-xl font-semibold text-foreground mb-4">Try This First</h2>
            <div className="grid gap-4 md:grid-cols-3">
              {microStrategies.map((strategy, index) => (
                <div key={index} className="bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm rounded-xl p-4">
                  <h3 className="font-medium text-foreground mb-2">{strategy.title}</h3>
                  <p className="text-sm text-muted-foreground">{strategy.description}</p>
                </div>
              ))}
            </div>
          </div>

          {/* Show All Strategies Button */}
          <div className="mb-8">
            <Button 
              variant="default"
              size="default"
              onClick={() => window.location.href = `/strategies?feeling=${encodeURIComponent(feelingName)}`}
              className="bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-xl"
            >
              <Heart className="h-4 w-4 mr-2" />
              Show All Strategies for {feelingName}
            </Button>
          </div>

          {/* Read More Guide Button */}
          {availableGuide && (
            <div className="mb-8">
              <div className="bg-white/40 dark:bg-gray-800/40 backdrop-blur-sm rounded-2xl p-6">
                <div className="flex items-center justify-center gap-2 mb-3">
                  <BookOpen className="h-5 w-5 text-blue-600" />
                  <h3 className="text-lg font-medium text-foreground">Need More Support?</h3>
                </div>
                <p className="text-sm text-muted-foreground mb-4 leading-relaxed text-center">
                  Read our comprehensive guide about {feelingName.toLowerCase()} with practical strategies and insights.
                </p>
                <div className="text-center">
                  <Button
                    onClick={() => window.location.href = `/guides/${availableGuide.slug}`}
                    className="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-xl transition-all duration-200"
                  >
                    <BookOpen className="h-4 w-4 mr-2" />
                    Read: {availableGuide.title}
                  </Button>
                </div>
              </div>
            </div>
          )}

          {/* Optional Navigation */}
          <div className="grid gap-4 md:grid-cols-2">
            <Button 
              variant="outline"
              size="default"
              onClick={() => window.location.href = '/tasks'}
              className="p-4 text-left h-auto"
            >
              <div>
                <div className="font-medium">Help with something specific?</div>
                <div className="text-sm text-muted-foreground">Go to Task Selector</div>
              </div>
            </Button>
            
            <Button 
              variant="outline"
              size="default"
              onClick={() => window.location.href = '/systems'}
              className="p-4 text-left h-auto"
            >
              <div>
                <div className="font-medium">Want to build a full routine?</div>
                <div className="text-sm text-muted-foreground">Go to Systems Lab</div>
              </div>
            </Button>
          </div>
        </div>
      </div>
    </div>
  )
}